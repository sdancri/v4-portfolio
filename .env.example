# ============================================================================
# V4 portfolio bot — Environment variables (Portainer Stack / docker compose)
# ============================================================================
# Multi-strategy, 3 perechi (shared equity pool, compound):
#   BTCUSDT (bb_mr) / TIAUSDT (hi) / NEARUSDT (hi) — vezi compose.V4.yml.
#
# Acest fisier = sursa unica pt sectiunea Portainer "Environment variables".
# In Portainer: buton "Load variables from .env file" → incarci acest fisier
# completat, apoi editezi secretele. compose.V4.yml refera fiecare ${VAR} de
# aici — daca lipseste una, container-ul primeste valoarea default (sau goala
# daca nu are default).
#
# NU comite .env real (doar .env.example).

# --- REQUIRED — Bybit credentials (Trade ENABLED, Withdraw DISABLED) --------
# Subaccount V4 (API key separata de restul botilor).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=0                     # 1 = testnet Bybit, 0 = mainnet (bani reali)
BYBIT_CATEGORY=linear                # produsul Bybit V5 (linear = USDT perpetual)

# --- REQUIRED — Capital inițial (genesis_account) ---------------------------
# Seteaza capitalul REAL alocat acestui bot inainte de primul boot (fara
# state.json existent). Dupa primul boot: genesis_account e FIXAT permanent
# (NICIODATA suprascris) — folosit doar pt afisarea "Capital inițial" vs
# "Capital actual" (%) in Telegram/dashboard. shared_equity porneste tot de
# aici si apoi creste/scade DOAR cu PnL real Bybit (compound local).
ACCOUNT_SIZE=100.0

# --- OPTIONAL — Telegram notifications --------------------------------------
# Lasa goale pentru a dezactiva Telegram (botul merge fara probleme).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- OPTIONAL — Branding & display -------------------------------------------
CHART_TZ=Europe/Bucharest
BOT_VERSION=                         # ex "v1.3 fix SL" sau git short SHA (linie pe chart)

# --- OPTIONAL — Dashboard control / reset -------------------------------------
# RESET_TOKEN partajat cu dashboard-ul agregat (vezi endpoints /api/pause|resume|stop).
RESET_TOKEN=
# BOT_CONTROL_URL = http://<container_name>:<chart_port>, default OK daca botul
# ruleaza pe reteaua Docker `bots` (DNS intern). Override doar daca ai alt setup.
BOT_CONTROL_URL=http://V4:8104
BOT_REPORTER_DB=/dashboard/state.db
BOT_REPORTER_HEARTBEAT_SEC=30

# --- OPTIONAL — Bind chart (Tailscale) ----------------------------------------
# IP-ul VPS in tailnet (`tailscale ip -4`). Chart-ul se leaga DOAR pe acest IP
# → accesibil prin Tailscale, NU public. Pt expunere publica: 0.0.0.0.
TAILSCALE_IP=100.92.198.95

# --- OPTIONAL — Rate limiter (Bybit V5: 10 req/s signed, 24 req/s public) ---
RATE_LIMIT_PER_SEC=5
RATE_LIMIT_BURST=10

# --- OPTIONAL — WS zombie watchdog --------------------------------------------
WS_ZOMBIE_TIMEOUT=60

# --- OPTIONAL — Memory monitor -------------------------------------------------
# Calibreaza per VPS — vezi comentariul "CALIBRARE PER-BOT" din compose.V4.yml.
MEM_MON_INTERVAL_SEC=300
MEM_MON_RSS_ALERT_MB=560

# --- OPTIONAL — Log-uri persistente (tee stdout/stderr → fisier rotativ) ------
# `docker logs` dispar la re-pull image in Portainer; fisierul /app/data/app.log
# (pe host: BOT_DATA_DIR/app.log) supravietuieste. Se roteste automat → NU umple
# discul. Cap total pe disc = LOG_MAX_BYTES × (LOG_BACKUP_COUNT + 1) (~60MB
# default). Activ mereu — DATA_DIR e deja setat in compose. Citeste:
# docker exec V4 cat /app/data/app.log
LOG_MAX_BYTES=10485760      # 10MB — marimea la care roteste (app.log → app.log.1)
LOG_BACKUP_COUNT=5          # cate fisiere vechi pastreaza (default cap ~60MB)

# --- OPTIONAL — PnL fallback ---------------------------------------------------
# Taker fee rate pt fallback PnL (cand Bybit closed-pnl nu se indexeaza).
TAKER_FEE_RATE=0.00055
